{
  "name": "background",
  "displayName": "Background Image",
  "version": "4.0.1",
  "description": "Show one full-opacity image behind the VS Code workbench.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "background",
    "background-image",
    "wallpaper"
  ],
  "homepage": "https://github.com/Rob-Keys/vscode-background#readme",
  "license": "MIT",
  "author": "Rob Keys",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rob-Keys/vscode-background.git"
  },
  "publisher": "RobKeys",
  "main": "./dist/extension",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.mjs",
    "package": "vsce package",
    "vscode:prepublish": "npm run build",
    "vscode:uninstall": "node ./dist/uninstall"
  },
  "dependencies": {
    "@vscode/sudo-prompt": "^9.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "extension.background.install",
        "category": "Background",
        "title": "Enable and apply background image"
      },
      {
        "command": "extension.background.disable",
        "category": "Background",
        "title": "Disable background image"
      },
      {
        "command": "extension.background.uninstall",
        "category": "Background",
        "title": "Uninstall Background Image"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Background Image",
      "properties": {
        "background.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Apply the background image to the VS Code workbench."
        },
        "background.image": {
          "type": "string",
          "default": "",
          "markdownDescription": "One local image path or HTTPS URL. Leave empty to remove the image."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.120.0"
  }
}
