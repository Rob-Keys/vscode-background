{
  "name": "background",
  "displayName": "background",
  "version": "3.0.1",
  "description": "Bring background images to your vscode",
  "categories": [
    "Other"
  ],
  "keywords": [
    "background",
    "background-image",
    "customize",
    "theme",
    "wallpaper"
  ],
  "homepage": "https://github.com/shalldie/vscode-background#readme",
  "license": "MIT",
  "author": "shalldie",
  "repository": {
    "type": "git",
    "url": "https://github.com/shalldie/vscode-background.git"
  },
  "publisher": "shalldie",
  "main": "./dist/extension",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.mjs",
    "package": "vsce package",
    "vscode:prepublish": "npm run build",
    "vscode:uninstall": "node ./dist/uninstall"
  },
  "dependencies": {
    "@vscode/sudo-prompt": "^9.3.2",
    "fast-glob": "^3.3.3",
    "stylis": "^4.4.0",
    "terser": "^5.48.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@types/stylis": "^4.2.7",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "extension.background.info",
        "category": "Background",
        "title": "Welcome to background."
      },
      {
        "command": "extension.background.install",
        "category": "Background",
        "title": "Enable and apply the background."
      },
      {
        "command": "extension.background.disable",
        "category": "Background",
        "title": "Disable the background."
      },
      {
        "command": "extension.background.uninstall",
        "category": "Background",
        "title": "Uninstall the extension."
      },
      {
        "command": "extension.background.previewPatch",
        "category": "Background",
        "title": "[Dev] Preview Patch"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "background",
      "properties": {
        "background.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether to enable background extension."
        },
        "background.editor": {
          "type": "object",
          "default": {
            "useFront": true,
            "style": {
              "background-position": "100% 100%",
              "background-size": "auto",
              "opacity": 0.6
            },
            "styles": [],
            "images": [],
            "interval": 0,
            "random": false
          },
          "properties": {
            "useFront": {
              "type": "boolean",
              "default": true,
              "markdownDescription": "Place the image above or below the code."
            },
            "style": {
              "type": "object",
              "default": {
                "background-position": "100% 100%",
                "background-size": "auto",
                "opacity": 0.6
              },
              "markdownDescription": "Custom style for images. [MDN Reference](https://developer.mozilla.org/docs/Web/CSS)"
            },
            "styles": {
              "type": "array",
              "default": [],
              "markdownDescription": "Custom style for each image individually. [MDN Reference](https://developer.mozilla.org/docs/Web/CSS)"
            },
            "images": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              },
              "markdownDescription": "Custom images, including online URLs, local files, and folders."
            },
            "interval": {
              "type": "number",
              "default": 0,
              "markdownDescription": "Seconds between carousel images; 0 disables the carousel."
            },
            "random": {
              "type": "boolean",
              "default": false,
              "markdownDescription": "Whether to randomly display images."
            }
          },
          "markdownDescription": "Editor section config."
        },
        "background.fullscreen": {
          "type": "object",
          "default": {
            "images": [],
            "opacity": 0.1,
            "size": "cover",
            "position": "center",
            "styles": [],
            "interval": 0,
            "random": false
          },
          "properties": {
            "images": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              },
              "markdownDescription": "Custom images, including online URLs, local files, and folders."
            },
            "opacity": {
              "type": "number",
              "default": 0.1,
              "minimum": 0,
              "maximum": 1,
              "markdownDescription": "Opacity of the images, from 0 to 1."
            },
            "size": {
              "type": "string",
              "default": "cover",
              "markdownDescription": "Alias for CSS background-size."
            },
            "position": {
              "type": "string",
              "default": "center",
              "markdownDescription": "Alias for CSS background-position."
            },
            "styles": {
              "type": "array",
              "default": [],
              "markdownDescription": "Custom style for each image individually."
            },
            "interval": {
              "type": "number",
              "default": 0,
              "markdownDescription": "Seconds between carousel images; 0 disables the carousel."
            },
            "random": {
              "type": "boolean",
              "default": false,
              "markdownDescription": "Whether to randomly display images."
            }
          },
          "markdownDescription": "Fullscreen section config."
        },
        "background.sidebar": {
          "type": "object",
          "default": {
            "images": [],
            "opacity": 0.1,
            "size": "cover",
            "position": "center",
            "styles": [],
            "interval": 0,
            "random": false
          },
          "properties": {
            "images": {
              "$ref": "#/properties/background.fullscreen/properties/images"
            },
            "opacity": {
              "$ref": "#/properties/background.fullscreen/properties/opacity"
            },
            "size": {
              "$ref": "#/properties/background.fullscreen/properties/size"
            },
            "position": {
              "$ref": "#/properties/background.fullscreen/properties/position"
            },
            "styles": {
              "$ref": "#/properties/background.fullscreen/properties/styles"
            },
            "interval": {
              "$ref": "#/properties/background.fullscreen/properties/interval"
            },
            "random": {
              "$ref": "#/properties/background.fullscreen/properties/random"
            }
          },
          "markdownDescription": "Sidebar section config."
        },
        "background.auxiliarybar": {
          "type": "object",
          "default": {
            "images": [],
            "opacity": 0.1,
            "size": "cover",
            "position": "center",
            "styles": [],
            "interval": 0,
            "random": false
          },
          "properties": {
            "images": {
              "$ref": "#/properties/background.fullscreen/properties/images"
            },
            "opacity": {
              "$ref": "#/properties/background.fullscreen/properties/opacity"
            },
            "size": {
              "$ref": "#/properties/background.fullscreen/properties/size"
            },
            "position": {
              "$ref": "#/properties/background.fullscreen/properties/position"
            },
            "styles": {
              "$ref": "#/properties/background.fullscreen/properties/styles"
            },
            "interval": {
              "$ref": "#/properties/background.fullscreen/properties/interval"
            },
            "random": {
              "$ref": "#/properties/background.fullscreen/properties/random"
            }
          },
          "markdownDescription": "Auxiliarybar section config."
        },
        "background.panel": {
          "type": "object",
          "default": {
            "images": [],
            "opacity": 0.1,
            "size": "cover",
            "position": "center",
            "styles": [],
            "interval": 0,
            "random": false
          },
          "properties": {
            "images": {
              "$ref": "#/properties/background.fullscreen/properties/images"
            },
            "opacity": {
              "$ref": "#/properties/background.fullscreen/properties/opacity"
            },
            "size": {
              "$ref": "#/properties/background.fullscreen/properties/size"
            },
            "position": {
              "$ref": "#/properties/background.fullscreen/properties/position"
            },
            "styles": {
              "$ref": "#/properties/background.fullscreen/properties/styles"
            },
            "interval": {
              "$ref": "#/properties/background.fullscreen/properties/interval"
            },
            "random": {
              "$ref": "#/properties/background.fullscreen/properties/random"
            }
          },
          "markdownDescription": "Panel section config."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.120.0"
  }
}
